# Dedicated PostgreSQL database for the Rust rewrite. Never point this at the Laravel database.
DATABASE_URL=postgres://paspapan:change-me@127.0.0.1:5432/paspapan_rewrite
APP_ORIGIN=http://127.0.0.1:4173

# Set to info for normal local development.
RUST_LOG=info

# The production-safe default is true. Opt out explicitly for plain HTTP on local development.
SESSION_COOKIE_SECURE=false
