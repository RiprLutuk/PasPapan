{
    "private": true,
    "version": "5.0.2",
    "type": "module",
    "engines": {
        "node": ">=24",
        "bun": ">=1.3.6"
    },
    "scripts": {
        "dev": "bun run --cwd apps/web dev",
        "dev:web": "bun run --cwd apps/web dev",
        "dev:api": "cargo run -p paspapan-api --bin paspapan-api",
        "dev:services": "node scripts/dev-local.mjs",
        "check": "bun run --cwd apps/web check",
        "build": "bun run --cwd apps/web build",
        "build:api": "cargo build --release -p paspapan-api --bin paspapan-api",
        "test:web": "node --test apps/web/tests/*.test.mjs",
        "test:api": "cargo test --workspace",
        "podman:init": "bash scripts/podman-machine.sh init",
        "podman:up": "bash scripts/podman-machine.sh up",
        "podman:down": "bash scripts/podman-machine.sh down",
        "podman:logs": "bash scripts/podman-machine.sh logs",
        "podman:status": "bash scripts/podman-machine.sh status",
        "evidence:review": "bash scripts/collect-review-evidence.sh",
        "brand:build": "bun --cwd apps/web ../../scripts/build-brand-assets.mjs",
        "brand:check": "node --test apps/web/tests/brand-assets.test.mjs"
    }
}
