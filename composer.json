{
    "name": "riprlutuk/paspapan",
    "type": "project",
    "description": "PasPapan workforce management platform for attendance, HR operations, approvals, and payroll preparation.",
    "keywords": [
        "attendance",
        "hr",
        "laravel",
        "livewire",
        "payroll",
        "workforce-management"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ballen/distical": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "blade-ui-kit/blade-heroicons": "^2.3",
        "blade-ui-kit/blade-icons": "^1.6",
        "endroid/qr-code": "^6",
        "intervention/image": "^4",
        "laravel/framework": "^13",
        "laravel/jetstream": "^5.1",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3",
        "livewire/livewire": "^4",
        "maatwebsite/excel": "^3.1",
        "predis/predis": "^3.5",
        "pusher/pusher-php-server": "^7.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.0",
        "laravel-lang/common": "^6.3",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/*.Source.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "check:ui": [
            "@php scripts/check-ui-rules.php"
        ],
        "check:modern-stack": [
            "@php scripts/check-modern-stack.php"
        ],
        "check:database-portability": [
            "@php artisan test tests/Unit/DatabasePortabilityStaticTest.php"
        ],
        "check:database-portability:sqlite": [
            "bash scripts/database-portability-smoke.sh sqlite"
        ],
        "check:database-portability:pgsql": [
            "bash scripts/database-portability-smoke.sh pgsql"
        ],
        "check:database-portability:mysql": [
            "bash scripts/database-portability-smoke.sh mysql"
        ],
        "check:enterprise-boundary": [
            "@php scripts/check-enterprise-boundary.php"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "lint:fix": [
            "@php vendor/bin/pint"
        ],
        "phpstan": [
            "@php vendor/bin/phpstan analyse --memory-limit=1G --no-progress --debug"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
