# syntax=docker/dockerfile:1
FROM docker.io/library/rust:slim-bookworm AS builder
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker

RUN cargo build --release --bin paspapan-api --bin migrate --bin seed_local

FROM docker.io/library/debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/paspapan-api /usr/local/bin/paspapan-api
COPY --from=builder /workspace/target/release/migrate /usr/local/bin/paspapan-migrate
COPY --from=builder /workspace/target/release/seed_local /usr/local/bin/paspapan-seed-local

ENV API_BIND=0.0.0.0:3000
ENV RUST_LOG=info
ENV AUTO_MIGRATE=true

EXPOSE 3000

CMD ["paspapan-api"]
