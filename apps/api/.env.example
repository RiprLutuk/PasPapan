# PasPapan Rust API Service (.env)
API_BIND=127.0.0.1:3000
DATABASE_URL=postgres://paspapan:paspapan@127.0.0.1:5432/paspapan
APP_ORIGIN=http://127.0.0.1:4173,http://localhost:4173
API_INTERNAL_KEY=paspapan-local-internal-service-key-change-me
SESSION_SECRET=paspapan-local-session-secret-change-me
RUST_LOG=info
SESSION_COOKIE_SECURE=false
AUTO_MIGRATE=true

# Object Storage (local | r2 | s3 | minio)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/objects
STORAGE_BUCKET=paspapan
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=true

# Transactional Mailer (local | smtp | resend | webhook)
MAIL_DRIVER=local
MAIL_FROM_NAME=PasPapan
MAIL_FROM_ADDRESS=no-reply@paspapan.app
MAIL_LOCAL_SPOOL=./var/mail
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_WEBHOOK_ENDPOINT=https://api.resend.com/emails
MAIL_API_KEY=

# External verifier bridge. HTTPS only; distinct random secrets of at least 32 bytes.
# Empty configuration disables verification. Client liveness is never server proof.
BIOMETRIC_VERIFIER_URL=
# Base64 of 32 random bytes, kept outside the database. Required for panel-managed credentials.
INTEGRATION_MASTER_KEY=
# Optional, used only by the read-only legacy preflight CLI.
LEGACY_DATABASE_URL=
BIOMETRIC_VERIFIER_SECRET=
DOCUMENT_SIGNER_URL=
DOCUMENT_SIGNER_SECRET=
